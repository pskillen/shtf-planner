  "scenarios": [
    {
      "id": "checklists-uk:power-cut",
      "name": "Power cut",
      "risks": ["grid"]
    },
    {
      "id": "checklists-uk:storm",
      "name": "Storm",
      "risks": ["storm"]
    }
  ],
  "steps": [
    {
      "id": "checklists-uk:torch",
      "text": "Keep a battery or wind-up torch and spare batteries where you can find them in the dark. Torches are safer than candles.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "coming",
      "order": 10,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:number",
      "text": "Write down the power-cut number and save it in your phone: 105 (England, Scotland, Wales) or 03457 643643 (Northern Ireland).",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "coming",
      "order": 20,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:radio",
      "text": "Keep a battery or wind-up radio with spare batteries. Write the frequencies of local and national stations on paper.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "coming",
      "order": 30,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:cash",
      "text": "Keep a small amount of cash for essentials in case card payments or cash machines are down.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "coming",
      "order": 40,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:register",
      "text": "If you may qualify, ask your energy supplier about the Priority Services Register (England, Scotland, Wales). In Northern Ireland, ask about the Customer Care Register.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "coming",
      "order": 50,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:landline",
      "text": "If you rely on a landline for emergency calls, or have telecare on it, ask your provider whether it works in a power cut.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "coming",
      "order": 60,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:medical-plan",
      "text": "If anyone uses medical equipment that needs power, make a plan with their care provider or clinical team: what to do, and who to contact, if the power goes off.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "coming",
      "order": 70,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:formula",
      "text": "If you use infant formula, keep some ready-made. It is the safest choice if tap water is unavailable.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "coming",
      "order": 80,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/",
      "requires": {
        "memberTag": "infant"
      }
    },
    {
      "id": "checklists-uk:solar-backup",
      "text": "Ask your installer whether your solar or battery system keeps running in a power cut. Some only do if designed to work without the grid.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "coming",
      "order": 90,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/",
      "requires": {
        "asset": ["assets-base:solar-pv", "assets-base:home-battery"]
      }
    },
    {
      "id": "checklists-uk:report",
      "text": "Report the power cut on your network operator's website. If you cannot, call 105 (free; England, Scotland, Wales) or 03457 643643 (Northern Ireland).",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "immediate",
      "order": 10,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:power-lines",
      "text": "Keep well away from power lines. High-voltage electricity can jump gaps without warning.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "immediate",
      "order": 20,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:appliances",
      "text": "Turn off irons, ovens, electric fires and fryers. Unplug your TV and computer to protect them from a surge when power returns.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "immediate",
      "order": 30,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:fridge-doors",
      "text": "Keep fridge and freezer doors shut so food stays cold for several hours.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "immediate",
      "order": 40,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:warm",
      "text": "Stay warm: wear layers, use blankets, close doors to rooms you are not using and draw the curtains.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "immediate",
      "order": 50,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:no-camping-stove",
      "text": "Never use a barbecue or camping stove indoors or inside a tent. The fumes contain carbon monoxide, which can kill.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "immediate",
      "order": 60,
      "source": "https://www.nhs.uk/conditions/carbon-monoxide-poisoning/"
    },
    {
      "id": "checklists-uk:generator",
      "text": "If you use a generator, never run it indoors or in an enclosed space such as a garage. Portable generators produce carbon monoxide, which can kill.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "immediate",
      "order": 70,
      "source": "https://www.nhs.uk/conditions/carbon-monoxide-poisoning/"
    },
    {
      "id": "checklists-uk:unattended",
      "text": "Never leave a fire, portable heater or generator running unattended. In heaters and stoves, use only the recommended fuel.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "immediate",
      "order": 80,
      "source": "https://www.gov.uk/government/publications/public-health-advice-from-uk-cmos-during-a-national-power-outage/keeping-warm-or-cool-in-extreme-weather-scripts-for-broadcast-media"
    },
    {
      "id": "checklists-uk:neighbours",
      "text": "Check in on your neighbours. If you can, offer to share blankets, clothing or food, and pass on any important information you have received about the power cut, such as when power is expected back.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "immediate",
      "order": 90,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:emergency-call",
      "text": "With no working landline in a life-threatening emergency, try 999 or 112 from a mobile. Emergency calls can use any available network.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "immediate",
      "order": 100,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:radio-news",
      "text": "Use a battery or wind-up radio for news. Try both FM and digital. In severe weather it may be safer to stay inside than to use your car radio.",
      "scenarios": ["checklists-uk:power-cut"],
      "phase": "immediate",
      "order": 110,
      "source": "https://beready.campaign.gov.uk/emergencies/power-cuts/"
    },
    {
      "id": "checklists-uk:storm-warnings",
      "text": "Check the Met Office forecast and National Severe Weather Warnings for your area, and follow any advice.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "coming",
      "order": 10,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-provider",
      "text": "Know who your power provider is and how to contact them during an outage.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "coming",
      "order": 20,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-charge",
      "text": "Charge your phones, power banks and any backup batteries for medical equipment.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "coming",
      "order": 30,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-loose-items",
      "text": "Secure loose items such as ladders, trampolines, garden furniture and toys.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "coming",
      "order": 40,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-doors-windows",
      "text": "Close and fasten doors and windows, especially those facing the wind, and large doors such as garage doors.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "coming",
      "order": 50,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-loft",
      "text": "Close and bolt loft hatches, particularly if your roof pitch is under 30 degrees.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "coming",
      "order": 60,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-shutters",
      "text": "If you have storm shutters, close and fasten them.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "coming",
      "order": 65,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-park",
      "text": "Park vehicles in a garage if you can. Otherwise keep them away from buildings, trees, walls and fences.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "coming",
      "order": 70,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-chimney",
      "text": "If you have tall chimney stacks in poor condition, move beds away from the areas directly below them.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "coming",
      "order": 80,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-limit-travel",
      "text": "Limit travel. If you must travel, allow extra time, check your travel operator's latest advice and follow any \"Do Not Travel\" notices.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "coming",
      "order": 90,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-check-vulnerable",
      "text": "Check on neighbours and others nearby who may need extra help, and offer practical support, such as getting food or medication.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "coming",
      "order": 100,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-stay-in",
      "text": "Stay indoors unless it is essential to go out. Avoid walking or sheltering near buildings, fences, walls and trees.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "immediate",
      "order": 10,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-sheltered-side",
      "text": "If you go out, use doors on the sheltered side and close them behind you. Keep away from the sheltered side of boundary walls and fences: if they fail, they fall that way.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "immediate",
      "order": 15,
      "source": "https://weather.metoffice.gov.uk/warnings-and-advice/seasonal-advice/your-home/stay-safe-in-a-storm"
    },
    {
      "id": "checklists-uk:storm-no-repairs",
      "text": "Do not go outside to repair damage while the storm is still going.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "immediate",
      "order": 20,
      "source": "https://weather.metoffice.gov.uk/warnings-and-advice/seasonal-advice/your-home/stay-safe-in-a-storm"
    },
    {
      "id": "checklists-uk:storm-internal-doors",
      "text": "Open internal doors only when you need to, and close them behind you.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "immediate",
      "order": 30,
      "source": "https://weather.metoffice.gov.uk/warnings-and-advice/seasonal-advice/your-home/stay-safe-in-a-storm"
    },
    {
      "id": "checklists-uk:storm-driving",
      "text": "If you must drive, avoid exposed routes such as bridges and high open roads where you can. Slow down for crosswinds, especially if towing or driving a high-sided vehicle.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "immediate",
      "order": 40,
      "source": "https://weather.metoffice.gov.uk/warnings-and-advice/seasonal-advice/your-home/stay-safe-in-a-storm"
    },
    {
      "id": "checklists-uk:storm-floodwater",
      "text": "Never drive through floodwater. Turn around and find another route.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "immediate",
      "order": 50,
      "source": "https://weather.metoffice.gov.uk/warnings-and-advice/seasonal-advice/travel/travelling-in-storms-rain-and-wind"
    },
    {
      "id": "checklists-uk:storm-fallen-cables",
      "text": "Keep well away from fallen or damaged power lines, and do not touch fallen or hanging electrical or telephone cables. High-voltage electricity can jump gaps without warning.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "immediate",
      "order": 60,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-coast",
      "text": "At the coast, beware of large waves, even from the shore: they can knock you off your feet and carry you out to sea. In an emergency, call 999 and ask for the Coastguard.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "immediate",
      "order": 70,
      "source": "https://weather.metoffice.gov.uk/warnings-and-advice/seasonal-advice/stay-safe-in-strong-wind"
    },
    {
      "id": "checklists-uk:storm-weakened",
      "text": "Stay clear of walls, buildings and trees, which may have been weakened.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "first-days",
      "order": 10,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-cables-after",
      "text": "Do not touch electrical or telephone cables that have been blown down or are still hanging.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "first-days",
      "order": 15,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    },
    {
      "id": "checklists-uk:storm-check-after",
      "text": "Check that neighbours and relatives who may need extra support are safe, and help them arrange repairs.",
      "scenarios": ["checklists-uk:storm"],
      "phase": "first-days",
      "order": 20,
      "source": "https://beready.campaign.gov.uk/emergencies/storms/"
    }
  ]
}
