{
  "format": 1,
  "id": "assets-base",
  "kind": "assets",
  "version": 2,
  "name": "Base household assets",
  "sources": [
    {
      "url": "https://beready.campaign.gov.uk/be-ready-for-emergencies/",
      "title": "Be Ready: be ready for emergencies (UK Government)",
      "checked": "2026-11-04"
    }
  ],
  "assets": [
    {
      "id": "assets-base:cabinet-heater",
      "name": "Cabinet gas heater (butane, 4.2 kW max)",
      "category": "heat",
      "questions": [
        {
          "id": "setting",
          "text": "Which setting do you run it on?",
          "kind": "choice",
          "choices": ["1.3 kW", "4.2 kW"]
        }
      ],
      "contributes": [
        {
          "capability": "heat",
          "when": {
            "question": "setting",
            "equals": "1.3 kW"
          },
          "converts": {
            "store": "lpgKg",
            "perHour": 0.095
          },
          "source": "assumption",
          "note": "Butane is about 12.9 kWh/kg, so 1.3 kW is roughly 0.1 kg/h; 95 g/h as the figure to plan on."
        },
        {
          "capability": "heat",
          "when": {
            "question": "setting",
            "equals": "4.2 kW"
          },
          "converts": {
            "store": "lpgKg",
            "perHour": 0.3
          },
          "source": "assumption",
          "note": "About 300 g/h at 4.2 kW (4.2 / 12.9 is 0.33 kg/h before efficiency). Verify against the manual."
        }
      ],
      "maintenance": [
        {
          "id": "fuel-rotate",
          "text": "Check the gas bottle and hose; swap old bottles",
          "everyMonths": 12
        },
        {
          "id": "service",
          "text": "Check the regulator and hose for wear",
          "everyMonths": 12
        }
      ]
    },
    {
      "id": "assets-base:catalytic-heater",
      "name": "Catalytic gas heater (1.3 kW)",
      "category": "heat",
      "questions": [],
      "contributes": [
        {
          "capability": "heat",
          "converts": {
            "store": "lpgKg",
            "perHour": 0.1
          },
          "source": "assumption",
          "note": "1.3 kW of butane or propane, about 0.1 kg/h."
        }
      ],
      "maintenance": [
        {
          "id": "fuel-rotate",
          "text": "Check the gas bottle and hose; swap old bottles",
          "everyMonths": 12
        }
      ]
    },
    {
      "id": "assets-base:wood-burner",
      "name": "Wood burner",
      "category": "heat",
      "questions": [],
      "contributes": [
        {
          "capability": "heat",
          "converts": {
            "store": "woodKg",
            "perHour": 1.5
          },
          "source": "assumption",
          "note": "Assumption: about 1.5 kg of seasoned logs an hour for a few kW."
        }
      ],
      "maintenance": [
        {
          "id": "sweep",
          "text": "Sweep the chimney",
          "everyMonths": 12
        }
      ]
    },
    {
      "id": "assets-base:paraffin-heater",
      "name": "Paraffin heater (2.5 kW)",
      "category": "heat",
      "questions": [],
      "contributes": [
        {
          "capability": "heat",
          "converts": {
            "store": "paraffinL",
            "perHour": 0.25
          },
          "source": "assumption",
          "note": "Paraffin is about 10 kWh/L, so 2.5 kW is about 0.25 L/h."
        }
      ],
      "maintenance": [
        {
          "id": "fuel-rotate",
          "text": "Use or replace stored paraffin",
          "everyMonths": 12
        },
        {
          "id": "wick",
          "text": "Check the wick and ventilate when used",
          "everyMonths": 12
        }
      ]
    },
    {
      "id": "assets-base:camping-stove",
      "name": "Camping stove (gas canister)",
      "category": "food",
      "questions": [],
      "contributes": [
        {
          "capability": "cooking",
          "converts": {
            "store": "gasCanister",
            "perHour": 0.4
          },
          "source": "assumption",
          "note": "From the game: about 90 g of butane an hour on a small burner."
        }
      ],
      "maintenance": [
        {
          "id": "fuel-rotate",
          "text": "Check canisters are in date and undamaged",
          "everyMonths": 12
        }
      ]
    },
    {
      "id": "assets-base:gas-bbq",
      "name": "Gas BBQ (LPG)",
      "category": "food",
      "questions": [
        {
          "id": "bottleKg",
