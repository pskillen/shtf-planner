          "kind": "number",
          "unit": "kg"
        }
      ],
      "contributes": [
        {
          "capability": "cooking",
          "converts": {
            "store": "lpgKg",
            "perHour": 0.3
          },
          "source": "assumption",
          "note": "Assumption: a 3-4 kW burner, about 0.3 kg/h. Outdoors only."
        }
      ],
      "maintenance": [
        {
          "id": "fuel-rotate",
          "text": "Check the bottle and hose",
          "everyMonths": 12
        }
      ]
    },
    {
      "id": "assets-base:rocket-stove",
      "name": "Rocket stove",
      "category": "food",
      "questions": [],
      "contributes": [
        {
          "capability": "cooking",
          "converts": {
            "store": "woodKg",
            "perHour": 1
          },
          "source": "assumption",
          "note": "Assumption: about 1 kg of dry sticks an hour. Outdoors only."
        }
      ],
      "maintenance": []
    },
    {
      "id": "assets-base:power-station",
      "name": "Portable power station",
      "category": "power",
      "questions": [
        {
          "id": "wh",
          "text": "Capacity?",
          "kind": "number",
          "unit": "Wh"
        }
      ],
      "contributes": [
        {
          "capability": "power",
          "storesWh": {
            "fromQuestion": "wh",
            "usableFraction": 0.85,
            "perUnitWh": 1
          },
          "source": "assumption",
          "note": "Assumption: about 85% is usable after inverter losses."
        }
      ],
      "maintenance": [
        {
          "id": "recharge",
          "text": "Recharge to about 60-80% and check it holds",
          "everyMonths": 3
        }
      ]
    },
    {
      "id": "assets-base:leisure-battery",
      "name": "Leisure battery",
      "category": "power",
      "questions": [
        {
          "id": "ah",
          "text": "Capacity?",
          "kind": "number",
          "unit": "Ah"
        }
      ],
      "contributes": [
        {
          "capability": "power",
          "storesWh": {
            "fromQuestion": "ah",
            "usableFraction": 0.5,
            "perUnitWh": 12
          },
          "source": "assumption",
          "note": "Assumption: 12 V nominal, and only half is usable from a lead-acid battery."
        }
      ],
      "maintenance": [
        {
          "id": "recharge",
          "text": "Recharge and check the voltage",
          "everyMonths": 3
        }
      ]
    },
    {
      "id": "assets-base:generator",
      "name": "Generator",
      "category": "power",
      "questions": [
        {
          "id": "fuel",
          "text": "What does it run on?",
          "kind": "choice",
          "choices": ["petrol", "lpg"]
        },
        {
          "id": "watts",
          "text": "Continuous output?",
          "kind": "number",
          "unit": "W"
        },
        {
          "id": "fuelPerHour",
          "text": "Fuel use per hour at that load (litres for petrol, kg for LPG)?",
          "kind": "number",
          "unit": "per hour"
        }
      ],
      "contributes": [
        {
          "capability": "power",
          "when": {
            "question": "fuel",
            "equals": "petrol"
          },
          "converts": {
            "store": "petrolL",
            "perHourFrom": "fuelPerHour"
          },
          "outputPerHour": {
            "fromQuestion": "watts"
          },
          "source": "assumption"
        },
        {
          "capability": "power",
          "when": {
            "question": "fuel",
            "equals": "lpg"
          },
          "converts": {
            "store": "lpgKg",
            "perHourFrom": "fuelPerHour"
          },
          "outputPerHour": {
            "fromQuestion": "watts"
          },
          "source": "assumption"
        }
      ],
      "maintenance": [
        {
          "id": "run",
          "text": "Run it on load for 20 minutes",
          "everyMonths": 1
        },
        {
          "id": "fuel-rotate",
          "text": "Use or replace stored fuel",
          "everyMonths": 12
        }
      ]
    },
    {
      "id": "assets-base:solar-pv",
      "name": "Solar PV array",
      "category": "power",
      "questions": [
        {
          "id": "kwp",
          "text": "Array size?",
          "kind": "number",
          "unit": "kWp"
        },
        {
          "id": "hasEps",
          "text": "Does it keep running in a grid outage (an emergency power supply fitted)?",
          "kind": "bool"
        }
      ],
      "contributes": [
        {
          "capability": "power",
          "when": {
            "question": "hasEps",
            "equals": true
          },
          "providesPerDayFrom": {
            "question": "kwp",
            "factor": 800
          },
          "source": "assumption",
          "note": "Assumption: about 800 Wh per kWp on a winter day in the UK. Without an EPS a grid-tied array stops with the grid, so it contributes nothing."
        }
      ],
      "maintenance": [
        {
          "id": "inspect",
          "text": "Inspect the panels and inverter display",
          "everyMonths": 12
        }
      ]
    },
    {
      "id": "assets-base:home-battery",
      "name": "Home battery",
      "category": "power",
      "questions": [
        {
          "id": "kwh",
          "text": "Capacity?",
          "kind": "number",
          "unit": "kWh"
        },
        {
          "id": "hasEps",
          "text": "Does it supply the house in a grid outage (EPS or islanding)?",
          "kind": "bool"
        }
      ],
      "contributes": [
        {
          "capability": "power",
          "when": {
            "question": "hasEps",
            "equals": true
          },
          "storesWh": {
            "fromQuestion": "kwh",
            "usableFraction": 0.9,
            "perUnitWh": 1000
          },
          "source": "assumption",
          "note": "Assumption: about 90% usable. Without an EPS the battery cannot supply the house in an outage."
        }
      ],
      "maintenance": []
    },
    {
      "id": "assets-base:ev",
      "name": "Electric car",
      "category": "power",
      "questions": [
        {
          "id": "kwh",
          "text": "Battery size?",
          "kind": "number",
          "unit": "kWh"
        },
        {
          "id": "v2l",
          "text": "Can it power a socket (vehicle-to-load)?",
          "kind": "bool"
        }
      ],
      "contributes": [
        {
          "capability": "power",
          "when": {
            "question": "v2l",
            "equals": true
          },
          "storesWh": {
            "fromQuestion": "kwh",
            "usableFraction": 0.5,
            "perUnitWh": 1000
          },
          "source": "assumption",
          "note": "Half the battery is counted as usable, so there is charge left to drive."
        }
      ],
      "maintenance": []
